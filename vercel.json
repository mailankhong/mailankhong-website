{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "echo 'Static site - bundle already in dist-orbital/, no build needed.'",
  "installCommand": "echo 'No install needed for static deployment.'",
  "outputDirectory": ".",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/linkedin-accelerator",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/linkedin-accelerator.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/about-me/",
      "destination": "/about-me",
      "permanent": true
    },
    {
      "source": "/done-for-you/",
      "destination": "/done-for-you",
      "permanent": true
    },
    {
      "source": "/done-with-you/",
      "destination": "/done-with-you",
      "permanent": true
    },
    {
      "source": "/privacy/",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/ai-content-systems/",
      "destination": "/ai-content-systems",
      "permanent": true
    },
    {
      "source": "/b2b-content-pipeline/",
      "destination": "/b2b-content-pipeline",
      "permanent": true
    },
    {
      "source": "/linkedin-for-teams/",
      "destination": "/linkedin-for-teams",
      "permanent": true
    },
    {
      "source": "/hiring-for-linkedin-content/",
      "destination": "/hiring-for-linkedin-content",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/dist-orbital/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, must-revalidate"
        }
      ]
    },
    {
      "source": "/brand_assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
